@charset "utf-8";

.app { max-width: 1200px; margin: 0px auto; padding: 20px; }

.header { display: flex; justify-content: space-between; align-items: cente=
r; flex-wrap: wrap; gap: 8px; margin-bottom: 20px; }

.header h1 { margin: 0px; font-size: 1.5rem; }

.status { font-size: 0.85rem; color: rgb(139, 152, 173); }

.dot { display: inline-block; width: 9px; height: 9px; border-radius: 50%; =
background: rgb(34, 197, 94); margin-right: 6px; }

.dot.off { background: rgb(239, 68, 68); }

.grid-cards { display: grid; gap: 14px; margin-bottom: 20px; grid-template-=
columns: repeat(auto-fit, minmax(160px, 1fr)); }

.card { background: rgb(19, 28, 46); border: 1px solid rgb(31, 43, 68); bor=
der-radius: 12px; padding: 16px; }

.card .label { color: rgb(139, 152, 173); font-size: 0.85rem; margin-bottom=
: 6px; }

.card .value { font-size: 2rem; font-weight: 700; }

.card.total { border-color: rgb(47, 107, 255); }

.grid-main { display: grid; gap: 14px; margin-bottom: 20px; grid-template-c=
olumns: repeat(auto-fit, minmax(340px, 1fr)); }

.panel h2 { margin: 0px 0px 12px; font-size: 1.05rem; }

.chart-box { width: 100%; height: 260px; }

.video-box { height: 260px; display: flex; align-items: center; justify-con=
tent: center; text-align: center; color: rgb(139, 152, 173); border: 1px da=
shed rgb(42, 58, 92); border-radius: 8px; padding: 12px; }

.table-wrap { overflow-x: auto; }

table { width: 100%; border-collapse: collapse; font-size: 0.9rem; }

th, td { text-align: left; padding: 10px 8px; border-bottom: 1px solid rgb(=
31, 43, 68); }

th { color: rgb(139, 152, 173); font-weight: 600; }

.swatch { display: inline-block; width: 12px; height: 12px; border-radius: =
50%; border: 1px solid rgb(85, 85, 85); margin-right: 6px; vertical-align: =
middle; }

.empty { color: rgb(139, 152, 173); padding: 12px 0px; }
